    {
      "id": "inv-001",
      "description": "Seed affinity cannot carry an outcome target",
      "base": "examples/valid/score/score_seed_affinity_included.json",
      "patch": [
        {
          "op": "add",
          "path": "/target",
          "value": {
            "event": "conversion",
            "horizon_days": 30
          }
        }
      ],
      "expect": {
        "layer": "schema",
        "keyword": "not",
        "path": ""
      }
    },
    {
      "id": "inv-002",
      "description": "Outcome probability requires a target",
      "base": "examples/valid/score/score_outcome_probability.json",
      "patch": [
        {
          "op": "remove",
          "path": "/target"
        }
      ],
      "expect": {
        "layer": "schema",
        "keyword": "required",
        "path": ""
      }
    },
    {
      "id": "inv-003",
