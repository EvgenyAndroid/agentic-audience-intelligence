{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aip.invalid/v1/agent_proposal.schema.json",
  "title": "Agent proposal",
  "description": "Advisory output of a bounded agent role. It is recorded and evaluated but never sets a task verdict.",
  "x-prd-requirements": [
    "FR38",
    "FR32",
    "NFR07"
  ],
  "type": "object",
  "properties": {
    "kind": {
      "const": "agent_proposal"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "proposal_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "task_ref": {
      "$ref": "common.schema.json#/$defs/versioned_ref"
    },
    "role": {
      "type": "string",
      "enum": [
        "briefing",
        "fitness",
        "meaning",
        "joins_features",
        "experiments",
        "evaluation",
        "output_preparation",
        "monitoring"
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "model_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "model_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "prompt_template_ref": {
      "$ref": "common.schema.json#/$defs/versioned_ref"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/versioned_ref"
      }
    },
    "proposed_verdict": {
      "$ref": "common.schema.json#/$defs/verdict"
    },
    "proposed_reasons": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/reason"
      }
    },
    "proposed_next_actions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/text"
      }
    },
    "proposed_artifacts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/versioned_ref"
      }
    },
    "authority": {
      "const": "advisory"
    },
    "usage_record_ref": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "proposal_id",
    "task_ref",
    "role",
    "model",
    "prompt_template_ref",
    "input_refs",
    "proposed_verdict",
    "proposed_reasons",
    "proposed_next_actions",
    "proposed_artifacts",
    "authority",
    "usage_record_ref",
    "created_at"
  ],
  "unevaluatedProperties": false
}
