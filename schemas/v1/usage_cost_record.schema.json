{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aip.invalid/v1/usage_cost_record.schema.json",
  "title": "Usage and cost record",
  "description": "Attributed usage and cost for a job, task, run or release. Feeds cost per comparable run, per reviewed release and contribution.",
  "x-prd-requirements": [
    "FR37",
    "NFR03",
    "NFR05"
  ],
  "type": "object",
  "properties": {
    "kind": {
      "const": "usage_cost_record"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "tenant_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "subject": {
      "type": "object",
      "properties": {
        "subject_type": {
          "type": "string",
          "enum": [
            "job",
            "task",
            "run",
            "release",
            "tenant_period"
          ]
        },
        "subject_ref": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "required": [
        "subject_type",
        "subject_ref"
      ],
      "additionalProperties": false
    },
    "period": {
      "$ref": "common.schema.json#/$defs/time_window"
    },
    "run_outcome": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "completed_with_output",
            "completed_abstained",
            "completed_no_useful_signal",
            "failed",
            "cancelled"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "comparable_run_class": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "compute_seconds": {
          "type": "number",
          "minimum": 0
        },
        "model_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "model_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "storage_gb_hours": {
          "type": "number",
          "minimum": 0
        },
        "scan_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "review_minutes": {
          "type": "number",
          "minimum": 0
        },
        "analyst_minutes": {
          "type": "number",
          "minimum": 0
        },
        "billable_impressions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "costs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "compute",
              "models",
              "storage",
              "review",
              "support",
              "source",
              "destination"
            ]
          },
          "amount": {
            "$ref": "common.schema.json#/$defs/decimal_string"
          },
          "currency": {
            "$ref": "common.schema.json#/$defs/currency"
          },
          "basis": {
            "type": "string",
            "enum": [
              "metered",
              "allocated",
              "contracted"
            ]
          },
          "allocation_method_ref": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/versioned_ref"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "category",
          "amount",
          "currency",
          "basis",
          "allocation_method_ref"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "allocated"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "properties": {
                "allocation_method_ref": {
                  "$ref": "common.schema.json#/$defs/versioned_ref"
                }
              }
            }
          }
        ]
      }
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "recorded_by": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "record_id",
    "tenant_id",
    "subject",
    "period",
    "run_outcome",
    "comparable_run_class",
    "usage",
    "costs",
    "recorded_at",
    "recorded_by"
  ],
  "unevaluatedProperties": false
}
